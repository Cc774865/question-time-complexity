{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiclass.local/schemas/textbook-models.json",
  "title": "人教版年级课内模型文件",
  "type": "object",
  "required": ["grade", "publisher", "school_system", "scope", "models"],
  "properties": {
    "grade": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    },
    "publisher": {
      "const": "人民教育出版社"
    },
    "school_system": {
      "const": "六三制"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/model"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "model": {
      "type": "object",
      "required": [
        "id",
        "name",
        "grade",
        "semester",
        "domain",
        "introduced_grade",
        "familiarity_by_grade",
        "topic_ids",
        "model_summary",
        "trigger_features",
        "standard_method",
        "common_variants",
        "uncommon_transforms",
        "auxiliary_line",
        "source_id",
        "item_refs",
        "rights_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^pep-g[1-9]-[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2
        },
        "grade": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "semester": {
          "enum": ["上", "下", "跨册"]
        },
        "domain": {
          "type": "string"
        },
        "introduced_grade": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "familiarity_by_grade": {
          "type": "object",
          "minProperties": 9,
          "maxProperties": 9,
          "additionalProperties": {
            "enum": [
              "introduced",
              "core",
              "reinforced",
              "uncommon_transform",
              "out_of_scope"
            ]
          }
        },
        "topic_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "model_summary": {
          "type": "string",
          "minLength": 8,
          "maxLength": 180
        },
        "trigger_features": {
          "type": "object",
          "required": ["stem_terms", "solution_terms", "minimum_term_hits"],
          "properties": {
            "stem_terms": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              }
            },
            "solution_terms": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              }
            },
            "minimum_term_hits": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "standard_method": {
          "type": "string",
          "minLength": 8,
          "maxLength": 180
        },
        "common_variants": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "uncommon_transforms": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "auxiliary_line": {
          "type": "object",
          "required": ["required", "strategy", "repetition_policy"],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "strategy": {
              "type": "string",
              "maxLength": 180
            },
            "repetition_policy": {
              "type": "string",
              "maxLength": 180
            }
          },
          "additionalProperties": false
        },
        "source_id": {
          "type": "string"
        },
        "item_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "chapter",
              "section",
              "page",
              "item_type",
              "item_number",
              "verification_status"
            ]
          }
        },
        "summary_author": {
          "type": "string"
        },
        "summary_version": {
          "type": "integer",
          "minimum": 1
        },
        "rights_status": {
          "const": "independent_non_reconstructive_summary"
        }
      },
      "additionalProperties": false
    }
  }
}
